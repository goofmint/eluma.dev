# ======================
# Database Configuration
# ======================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-super-secret-password
POSTGRES_DB=eluma
POSTGRES_PORT=5432

# ======================
# Supabase Configuration
# ======================
# Generate these with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long
SECRET_KEY_BASE=your-super-secret-key-base-with-at-least-32-characters-long

# Realtime DB Encryption Key
# WARNING: This is a sample key for local development ONLY
# Production deployments MUST generate a new key with `openssl rand -base64 32`
# and store it securely via environment/secret management
REALTIME_DB_ENC_KEY=Kn8EiDt5NajuKU4mu5Vy99hbv1E/O2BLL4lVDOcmuxU=

# Supabase Keys (generate with: openssl rand -base64 32)
# For local development, you can use the example keys below
# NEVER use these in production!
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# ======================
# Supabase Auth Settings
# ======================
SITE_URL=http://localhost:3000
API_EXTERNAL_URL=http://localhost:8000
ADDITIONAL_REDIRECT_URLS=
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true
JWT_EXPIRY=3600

# ======================
# SMTP Configuration (Optional)
# ======================
# Required for email-based authentication (magic links, password reset, etc.)
# Leave empty to use console-based email for local development
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=Eluma

# Email Templates
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify

# ======================
# Port Configuration
# ======================
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443
STUDIO_PORT=54323
API_PORT=8787
WEB_PORT=3000

# ======================
# PostgREST Configuration
# ======================
PGRST_DB_SCHEMAS=public,storage,graphql_public

# ======================
# Storage Configuration
# ======================
IMGPROXY_ENABLE_WEBP_DETECTION=true

# ======================
# Application Configuration
# ======================
# OpenAI API Key (for comment moderation and MCP)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Vite Configuration (for web app)
VITE_API_URL=http://localhost:8787
VITE_SUPABASE_URL=http://localhost:8000
VITE_SUPABASE_ANON_KEY=${SUPABASE_ANON_KEY}

# ======================
# Development Mode
# ======================
NODE_ENV=development
