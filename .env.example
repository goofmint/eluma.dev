# ======================
# Database Configuration
# ======================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-super-secret-password
POSTGRES_DB=eluma
POSTGRES_PORT=5432

# ======================
# Auth Configuration
# ======================
# REQUIRED: Generate a secure secret with: openssl rand -base64 32
# Docker Compose will fail if this is not set
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long

# Supabase Keys for local development
# These are demo keys - NEVER use in production!
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# ======================
# Auth Settings
# ======================
SITE_URL=https://eluma.test
API_EXTERNAL_URL=https://eluma.test/auth
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
# Set to true to skip email verification (dev only, defaults to false)
ENABLE_EMAIL_AUTOCONFIRM=true
JWT_EXPIRY=3600

# ======================
# SMTP Configuration (Optional)
# ======================
# Leave empty for console-based email in development
SMTP_ADMIN_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=Eluma

# ======================
# Port Configuration
# ======================
STUDIO_PORT=54323
API_PORT=8787
WEB_PORT=3000

# ======================
# Application Configuration
# ======================
# OpenAI API Key (for comment moderation and MCP)
OPENAI_API_KEY=sk-your-openai-api-key-here

# CORS allowed origins (comma-separated, or '*' for all)
# Example: https://example.com,https://app.example.com
ALLOWED_ORIGINS=*

# Frontend environment variables (optional, defaults to relative paths)
# VITE_API_URL=/api
# VITE_AUTH_URL=/auth
VITE_SUPABASE_ANON_KEY=${SUPABASE_ANON_KEY}

# ======================
# Development Mode
# ======================
NODE_ENV=development
